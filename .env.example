# Production Compose settings. This file contains no usable secret.
# Copy outside Git, protect permissions, and pass with docker compose --env-file.
DOMAIN=example.com
APP_SECRET=
STORAGE_PATH=/var/lib/normacheck/storage
APP_IMAGE=normacheck:local
CADDY_IMAGE=caddy:2-alpine

COOKIE_SECURE=true
MAX_CONCURRENT_JOBS=2
WORKER_MEMORY_MB=768
MAX_UPLOAD_MB=20
MAX_STORAGE_MB=2048
PROCESSING_TIMEOUT_SECONDS=60
UPLOAD_TIMEOUT_SECONDS=120
UPLOAD_IDLE_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_BURST=4
RATE_LIMIT_MAX_CLIENTS=4096

# Initial profile for Ubuntu 24.04, 1 CPU, 1 GiB RAM + 3 GiB host swap.
# Requires measurements on the target VPS. Swap is not configured by Compose.
APP_MEMORY_LIMIT=640m
APP_MEMORY_SWAP_LIMIT=2560m
APP_CPU_LIMIT=0.9
PROXY_MEMORY_LIMIT=96m
PROXY_MEMORY_SWAP_LIMIT=192m

# A dedicated subnet lets Uvicorn trust exactly the proxy address.
# Change the subnet and both addresses together if it overlaps an existing network.
DOCKER_SUBNET=172.30.76.0/29
PROXY_IP=172.30.76.2
APP_IP=172.30.76.3
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# Request limit = MAX_UPLOAD_MB * 1048576 + 1048576 (multipart overhead).
MAX_REQUEST_BODY_BYTES=22020096
# Keep proxy deadlines above the application deadlines.
PROXY_UPLOAD_TIMEOUT=130s
PROXY_RESPONSE_TIMEOUT=200s
# Local HTTP check only: SITE_ADDRESS=http://localhost, DOMAIN=localhost,
# COOKIE_SECURE=false, HTTP_BIND=127.0.0.1, HTTP_PORT=18080, HTTPS_PORT=18443.
